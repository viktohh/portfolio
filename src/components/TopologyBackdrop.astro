---
// Decorative network-topology backdrop. Generated at build time (deterministic),
// so it ships as plain SVG — no JavaScript. Packets animate with SVG <animateMotion>
// and are hidden for users who prefer reduced motion.

interface Props {
  /** 'hero' fades out on the left so text stays readable; 'subtle' is fainter all over. */
  variant?: 'hero' | 'subtle';
  seed?: number;
}

const { variant = 'hero', seed = 7 } = Astro.props;
const uid = `topo-${variant}-${seed}`;

function rng(a: number) {
  return () => {
    a |= 0;
    a = (a + 0x6d2b79f5) | 0;
    let t = Math.imul(a ^ (a >>> 15), 1 | a);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}
const rand = rng(seed);

const W = 1400;
const H = 640;
const cols = 11;
const rows = 5;
const cw = W / cols;
const ch = H / rows;

type P = { x: number; y: number; hub: boolean };
const pts: P[] = [];
for (let r = 0; r < rows; r++) {
  for (let c = 0; c < cols; c++) {
    if (rand() < 0.22) continue; // leave gaps so it looks organic
    pts.push({
      x: Math.round(c * cw + cw / 2 + (rand() - 0.5) * cw * 0.7),
      y: Math.round(r * ch + ch / 2 + (rand() - 0.5) * ch * 0.7),
      hub: false,
    });
  }
}
// A few "devices" drawn as rounded squares
for (let i = 0; i < 6; i++) pts[Math.floor(rand() * pts.length)].hub = true;

// Connect each node to its 3 nearest neighbours
const key = (a: number, b: number) => (a < b ? `${a}-${b}` : `${b}-${a}`);
const edgeSet = new Map<string, [P, P]>();
pts.forEach((p, i) => {
  pts
    .map((q, j) => ({ j, d: Math.hypot(p.x - q.x, p.y - q.y) }))
    .filter((o) => o.j !== i && o.d < 270)
    .sort((a, b) => a.d - b.d)
    .slice(0, 3)
    .forEach((o) => edgeSet.set(key(i, o.j), [p, pts[o.j]]));
});
const edges = [...edgeSet.values()];

// Packets travelling along a handful of links
const packets = Array.from({ length: 8 }, () => {
  const [a, b] = edges[Math.floor(rand() * edges.length)];
  const forward = rand() > 0.5;
  const [s, e] = forward ? [a, b] : [b, a];
  return {
    path: `M${s.x} ${s.y} L${e.x} ${e.y}`,
    dur: (2.6 + rand() * 2.8).toFixed(1),
    begin: (-rand() * 4).toFixed(1),
  };
});
---

<div class={`topo topo--${variant}`} aria-hidden="true">
  <svg viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMid slice" focusable="false">
    <defs>
      <linearGradient id={`${uid}-fade`} x1="0" x2="1" y1="0" y2="0">
        {variant === 'hero' ? (
          <>
            <stop offset="0" stop-color="#fff" stop-opacity="0.06" />
            <stop offset="0.45" stop-color="#fff" stop-opacity="0.35" />
            <stop offset="0.75" stop-color="#fff" stop-opacity="1" />
          </>
        ) : (
          <>
            <stop offset="0" stop-color="#fff" stop-opacity="0.5" />
            <stop offset="1" stop-color="#fff" stop-opacity="0.9" />
          </>
        )}
      </linearGradient>
      <linearGradient id={`${uid}-vfade`} x1="0" x2="0" y1="0" y2="1">
        <stop offset="0" stop-color="#000" stop-opacity="0" />
        <stop offset="0.7" stop-color="#000" stop-opacity="0" />
        <stop offset="1" stop-color="#000" stop-opacity="1" />
      </linearGradient>
      <mask id={`${uid}-mask`}>
        <rect width={W} height={H} fill={`url(#${uid}-fade)`} />
        <rect width={W} height={H} fill={`url(#${uid}-vfade)`} />
      </mask>
    </defs>

    <g mask={`url(#${uid}-mask)`}>
      <g class="topo-links">
        {edges.map(([a, b]) => <line x1={a.x} y1={a.y} x2={b.x} y2={b.y} />)}
      </g>
      <g class="topo-nodes">
        {pts.map((p) =>
          p.hub ? (
            <rect class="hub" x={p.x - 9} y={p.y - 9} width="18" height="18" rx="5" />
          ) : (
            <circle cx={p.x} cy={p.y} r="3.5" />
          ),
        )}
      </g>
      <g class="topo-packets">
        {packets.map((pk) => (
          <circle r="3">
            <animateMotion dur={`${pk.dur}s`} begin={`${pk.begin}s`} repeatCount="indefinite" path={pk.path} />
          </circle>
        ))}
      </g>
    </g>
  </svg>
</div>

<style>
  .topo {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }
  .topo svg {
    width: 100%;
    height: 100%;
    display: block;
  }
  .topo-links line {
    stroke: var(--accent);
    stroke-width: 1.2;
    opacity: 0.22;
  }
  .topo-nodes circle {
    fill: var(--bg);
    stroke: var(--accent);
    stroke-width: 1.5;
    opacity: 0.45;
  }
  .topo-nodes .hub {
    fill: var(--accent-soft);
    stroke: var(--accent);
    stroke-width: 1.5;
    opacity: 0.6;
  }
  .topo-packets circle {
    fill: var(--accent);
    opacity: 0.75;
  }
  .topo--subtle {
    opacity: 0.6;
  }
  :global([data-theme='dark']) .topo-links line {
    opacity: 0.18;
  }
  @media (max-width: 680px) {
    .topo {
      opacity: 0.55;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .topo-packets {
      display: none;
    }
  }
</style>
